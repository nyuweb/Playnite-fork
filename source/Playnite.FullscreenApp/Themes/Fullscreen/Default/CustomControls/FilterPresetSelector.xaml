<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Platform pills: every item is a rounded pill with 5px inner padding, floating above the bottom panel.
        Only the current (checked) pill is filled like the bottom panel, with the opposite grey border.
    -->
    <Style x:Key="ItemFilterQuickPreset" TargetType="CheckBoxEx">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBoxEx">

                    <Grid x:Name="GridBox" Margin="8,26,8,0" Height="82" MinWidth="82" UseLayoutRounding="True" Opacity="0.75">

                        <Border x:Name="PillBorder" CornerRadius="31" BorderThickness="2" Padding="15"
                                Background="Transparent" BorderBrush="Transparent">
                            <Grid>
                                <Image x:Name="FilterIcon" RenderOptions.BitmapScalingMode="Fant" Height="48" Stretch="Uniform"
                                       Source="{ThemeFileBinding Name, PathFormat='Icons/Filter/{0}.png'}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" x:Name="TextContent" Margin="14,0" FontSize="20">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=FilterIcon, Path=Source}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="GridBox" />
                            <Setter Property="Background" Value="#22FFFFFF" TargetName="PillBorder" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="GridBox" />
                            <Setter Property="Background" Value="#33FFFFFF" TargetName="PillBorder" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="GridBox" />
                            <Setter Property="Background" Value="{DynamicResource BottomPanelBackgroundBrush}" TargetName="PillBorder" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BottomPanelBorderBrush}" TargetName="PillBorder" />
                            <Setter Property="Foreground" Value="{DynamicResource BottomPanelForegroundBrush}" TargetName="TextContent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header of the "More" grid: platform logo (or name) without the pill background and border -->
    <DataTemplate x:Key="MoreGamesHeaderTemplate">
        <Border Height="48" HorizontalAlignment="Left">
            <Grid>
                <Image x:Name="HeaderIcon" RenderOptions.BitmapScalingMode="Fant" Height="48" Stretch="Uniform"
                       Source="{ThemeFileBinding Title, PathFormat='Icons/Filter/{0}.png'}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="28" Margin="14,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource BottomPanelForegroundBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=HeaderIcon, Path=Source}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DataTemplate>

    <Style TargetType="{x:Type FilterPresetSelector}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="{StaticResource DesignWidth}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPresetSelector}">
                    <ItemsControlEx x:Name="PART_ItemsFilterPresets" Focusable="False"
                                    KeyboardNavigation.DirectionalNavigation="Once"
                                    HorizontalLayout="True" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>                            
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" >

                            <StackPanel.Style>
                                <Style>
                                    <Setter Property="ItemsControl.MaxWidth" Value="{StaticResource DesignWidth}"/>
                                    <Style.Triggers>

                                                    <DataTrigger Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="True">
                                                        <Setter Property="ItemsControl.MaxWidth" Value="1760" />
                                                    </DataTrigger>


                                                    <DataTrigger Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False">
                                                        <Setter Property="ItemsControl.MaxWidth" Value="870" />
                                                    </DataTrigger>

                                    </Style.Triggers>                                
				</Style>
                            </StackPanel.Style>
			</StackPanel>

                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="True">
                                    <ItemsPresenter Margin="16,0" />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControlEx>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>